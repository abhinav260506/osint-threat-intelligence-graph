# ==============================================================================
# OSINT Threat Intelligence & Graph Data Science Platform - Environment Config
# ==============================================================================

# Application
APP_NAME=ThreatGraph-AI
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=threatgraph-dev-super-secret-key-change-in-production-min32chars!

# Server & Network
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ThreatIntelGraphPassword123!
NEO4J_DATABASE=neo4j

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=10

# Intelligence Quality & Confidence Thresholds
MIN_CONFIDENCE_THRESHOLD=0.35
CORROBORATION_REQUIRED_COUNT=2
MAX_GRAPH_HOP_DEPTH=4
